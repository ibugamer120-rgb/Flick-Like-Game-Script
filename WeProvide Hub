local ActiveSelectedScript = nil
local ActiveListButtons = {}

local function RenderConsoleUI(selectedData, associatedButton)
	ActiveSelectedScript = selectedData
	
	-- Update Selection Visual States
	for _, btn in ipairs(ActiveListButtons) do
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 27, 34)}):Play()
		btn:FindFirstChildOfClass("UIStroke").Color = BORDER_COLOR
	end
	TweenService:Create(associatedButton, TweenInfo.new(0.2), {BackgroundColor3 = PANEL_CARD}):Play()
	associatedButton:FindFirstChildOfClass("UIStroke").Color = ACCENT_MINT

	-- Populating Data Metrics
	PreviewTitle.Text = selectedData.Name
	DescriptionBox.Text = selectedData.Description
	MetaDev.Text = "AUTHOR: " .. string.upper(selectedData.Developer)
	MetaVer.Text = "CORE: " .. string.upper(selectedData.Version)
	StatusBadge.Text = string.upper(selectedData.Status)
	
	if selectedData.Status == "Operational" then
		StatusBadge.TextColor3 = ACCENT_MINT
		LaunchModuleBtn.BackgroundColor3 = ACCENT_MINT
		LaunchModuleBtn.Text = "RUN ENGINE SCRIPT"
	else
		StatusBadge.TextColor3 = ERRORED_RED
		LaunchModuleBtn.BackgroundColor3 = PANEL_CARD
		LaunchModuleBtn.Text = "MODULE SYSTEM LOCKED"
	end
	
	MetadataGroup.Visible = true
	LaunchModuleBtn.Visible = true
end

