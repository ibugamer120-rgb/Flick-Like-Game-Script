----------------------------------------------------------------
-- CINEMATIC TERMINATION LOGIC (RUN & DESTROY)
----------------------------------------------------------------

LaunchModuleBtn.MouseButton1Click:Connect(function()
	if not ActiveSelectedScript or ActiveSelectedScript.Status ~= "Operational" then return end
	
	triggerRippleEffect(LaunchModuleBtn, Mouse.X, Mouse.Y)
	LaunchModuleBtn.Text = "COMPILING RUNTIME CORE..."
	LaunchModuleBtn.TextColor3 = TEXT_DESC
	
	task.spawn(function()
		local networkSuccess, rawPayload = pcall(function()
			return game:HttpGet(ActiveSelectedScript.Url)
		end)
		
		if networkSuccess and rawPayload then
			local compiledFunction, syntaxError = loadstring(rawPayload)
			if compiledFunction then
				-- Play cinematic fade-out animation
				local closingTween = TweenService:Create(CanvasGroup, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Size = UDim2.new(0, 640, 0, 380),
					GroupTransparency = 1
				})
				closingTween:Play()
				closingTween.Completed:Wait()
				
				-- Destroy UI object completely from game memory
				PremiumHubGui:Destroy()
				
				-- Execute the freshly pulled clean codebase in its isolated container
				task.spawn(compiledFunction)
			else
				warn("[WeProvide Compiler Error]: " .. tostring(syntaxError))
				LaunchModuleBtn.Text = "COMPILATION FAILED"
				LaunchModuleBtn.TextColor3 = ERRORED_RED
			end
		else
			warn("[WeProvide Handshake Error]: Failed to reach source distribution cluster.")
			LaunchModuleBtn.Text = "NETWORK HANDSHAKE TIMEOUT"
			LaunchModuleBtn.TextColor3 = ERRORED_RED
		end
	end)
end)

