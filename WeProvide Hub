----------------------------------------------------------------
-- CARD CREATION ENGINE
----------------------------------------------------------------

for _, moduleData in ipairs(ScriptRegistry) do
	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1, -6, 0, 64)
	Card.BackgroundColor3 = PANEL_BODY
	Card.Parent = CardsContainer
	addCorner(Card, 6)
	local cardStroke = addStroke(Card, SEPARATOR_LINE, 1)

	local Title = Instance.new("TextLabel")
	Title.Size = UDim2.new(0.65, 0, 0, 24)
	Title.Position = UDim2.new(0, 12, 0, 8)
	Title.BackgroundTransparency = 1
	Title.Text = moduleData.Name
	Title.TextColor3 = TEXT_MAIN
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 13
	Title.TextXAlignment = Enum.TextXAlignment.Left
	Title.Parent = Card

	local Desc = Instance.new("TextLabel")
	Desc.Size = UDim2.new(0.65, 0, 0, 24)
	Desc.Position = UDim2.new(0, 12, 0, 28)
	Desc.BackgroundTransparency = 1
	Desc.Text = moduleData.Description
	Desc.TextColor3 = TEXT_MUTED
	Desc.Font = Enum.Font.GothamMedium
	Desc.TextSize = 11
	Desc.TextWrap = true
	Desc.TextXAlignment = Enum.TextXAlignment.Left
	Desc.Parent = Card

	local LaunchButton = Instance.new("TextButton")
	LaunchButton.Size = UDim2.new(0, 90, 0, 28)
	LaunchButton.Position = UDim2.new(1, -102, 0.5, -14)
	LaunchButton.BackgroundColor3 = TOGGLE_DARK
	LaunchButton.Text = "EXECUTE"
	LaunchButton.Font = Enum.Font.GothamBold
	LaunchButton.TextSize = 10
	LaunchButton.TextColor3 = ACCENT_MINT
	LaunchButton.ClipsDescendants = true
	LaunchButton.Parent = Card
	addCorner(LaunchButton, 4)
	addStroke(LaunchButton, SEPARATOR_LINE, 1)

	Card.MouseEnter:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(40, 40, 48)}):Play()
	end)
	Card.MouseLeave:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = SEPARATOR_LINE}):Play()
	end)

	LaunchButton.MouseButton1Click:Connect(function()
		createRipple(LaunchButton, Mouse.X, Mouse.Y)
		
		LaunchButton.Text = "LOADING..."
		LaunchButton.TextColor3 = TEXT_MUTED
		
		task.spawn(function()
			local success, response = pcall(function()
				return game:HttpGet(moduleData.Url)
			end)
			
			if success and response then
				LaunchButton.Text = "RUNNING"
				LaunchButton.TextColor3 = Color3.fromRGB(255, 255, 255)
				LaunchButton.BackgroundColor3 = ACCENT_MINT
				
				local func, err = loadstring(response)
				if func then
					task.spawn(func)
				else
					warn("Error compiling script code: " .. tostring(err))
					LaunchButton.Text = "STR_ERR"
					LaunchButton.TextColor3 = Color3.fromRGB(255, 50, 50)
				end
			else
				warn("Failed to reach GitHub link.")
				LaunchButton.Text = "HTTP_ERR"
				LaunchButton.TextColor3 = Color3.fromRGB(255, 50, 50)
			end
		end)
	end)
end

----------------------------------------------------------------
-- SHOW / HIDE CONTROLLER
----------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or UserInputService:GetFocusedTextBox() ~= nil then return end
	
	if input.KeyCode == Enum.KeyCode.RightShift then
		hubVisible = not hubVisible
		if hubVisible then
			MainPanel.Visible = true
			TweenService:Create(MainPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 500, 0, 340), BackgroundTransparency = 0}):Play()
		else
			TweenService:Create(MainPanel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 500, 0, 0), BackgroundTransparency = 1}):Play()
			task.delay(0.2, function() if not hubVisible then MainPanel.Visible = false end end)
		end
	end
end)
