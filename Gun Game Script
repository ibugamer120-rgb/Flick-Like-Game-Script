local ActiveEspRegistry = {}

local function CreateEspProfile(player)
	if ActiveEspRegistry[player] then return end
	
	local Box = Drawing.new("Square")
	Box.Visible = false
	Box.Color = ACCENT_MINT
	Box.Thickness = 1.5
	Box.Filled = false
	Box.Transparency = 0.8
	
	local Tracer = Drawing.new("Line")
	Tracer.Visible = false
	Tracer.Color = TEXT_MAIN
	Tracer.Thickness = 1
	Tracer.Transparency = 0.6
	
	ActiveEspRegistry[player] = {Box = Box, Tracer = Tracer}
end

local function RemoveEspProfile(player)
	if ActiveEspRegistry[player] then
		ActiveEspRegistry[player].Box:Destroy()
		ActiveEspRegistry[player].Tracer:Destroy()
		ActiveEspRegistry[player] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LocalPlayer then CreateEspProfile(p) end
end
Players.PlayerAdded:Connect(CreateEspProfile)
Players.PlayerRemoving:Connect(RemoveEspProfile)

RunService.RenderStepped:Connect(function()
	for player, assets in pairs(ActiveEspRegistry) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		
		local showBox = false
		local showTracer = false
		
		if root and hum and hum.Health > 0.1 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
			local pos, onScreen = CurrentCamera:WorldToViewportPoint(root.Position)
			
			if onScreen then
				-- Calculate dimensional size constraints based on physical camera depth scaling
				local camDistance = (CurrentCamera.CFrame.Position - root.Position).Magnitude
				local boxHeight = math.clamp((1000 / camDistance) * 3, 10, 200)
				local boxWidth = boxHeight * 0.7
				
				if EspBoxesEnabled then
					assets.Box.Size = Vector2.new(boxWidth, boxHeight)
					assets.Box.Position = Vector2.new(pos.X - boxWidth/2, pos.Y - boxHeight/2)
					showBox = true
				end
				
				if EspTracersEnabled then
					assets.Tracer.From = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y)
					assets.Tracer.To = Vector2.new(pos.X, pos.Y)
					showTracer = true
				end
			end
		end
		
		assets.Box.Visible = showBox
		assets.Tracer.Visible = showTracer
	end
end)

----------------------------------------------------------------
-- KINETIC DOUBLE JUMP ENGINE
----------------------------------------------------------------

UserInputService.JumpRequest:Connect(function()
	if not DoubleJumpEnabled then return end
	
	local myChar = LocalPlayer.Character
	local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local hum = myChar and myChar:FindFirstChild("Humanoid")
	
	if hrp and hum and hum.Health > 0 then
		if canDoubleJump and not hasDoubleJumped then
			hasDoubleJumped = true
			hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, DoubleJumpPower, hrp.AssemblyLinearVelocity.Z)
		end
	end
end)

local function setupStateTracker(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end
	
	humanoid.StateChanged:Connect(function(oldState, newState)
		if not DoubleJumpEnabled then return end
		if newState == Enum.HumanoidStateType.Landed then
			canDoubleJump = false
			hasDoubleJumped = false
		elseif newState == Enum.HumanoidStateType.Freefall then
			task.wait(0.1)
			if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
				canDoubleJump = true
			end
		end
	end)
end

if LocalPlayer.Character then setupStateTracker(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupStateTracker)

local savedMaterials = {}
task.spawn(function()
	while task.wait(0.2) do
		local myChar = LocalPlayer.Character
		if myChar then
			for _, part in ipairs(myChar:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					if InvisEnabled then
						if not savedMaterials[part] then
							savedMaterials[part] = {Transparency = part.Transparency, CanCollide = part.CanCollide}
						end
						part.Transparency = 1
						part.CanCollide = false
					else
						if savedMaterials[part] then
							part.Transparency = savedMaterials[part].Transparency
							part.CanCollide = savedMaterials[part].CanCollide
							savedMaterials[part] = nil
						end
					end
				elseif part:IsA("Decal") then
					part.Transparency = InvisEnabled and 1 or 0
				end
			end
		end
	end
end)

