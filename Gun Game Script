local ActiveEspRegistry = {}

local function CreateEspProfile(player)
	if ActiveEspRegistry[player] then return end
	
	local Box = Drawing.new("Square")
	Box.Visible = false
	Box.Color = ACCENT_MINT
	Box.Thickness = 1.5
	Box.Filled = false
	Box.Transparency = 0.8
	
	local Tracer = Drawing.new("Line")
	Tracer.Visible = false
	Tracer.Color = TEXT_MAIN
	Tracer.Thickness = 1
	Tracer.Transparency = 0.6
	
	local Brackets = {}
	for i = 1, 8 do
		local Line = Drawing.new("Line")
		Line.Color = ACCENT_MINT
		Line.Thickness = 1.5
		Line.Visible = false
		Line.Transparency = 0.85
		table.insert(Brackets, Line)
	end
	
	local HealthBarBg = Drawing.new("Line")
	HealthBarBg.Color = Color3.fromRGB(40, 40, 45)
	HealthBarBg.Thickness = 2
	HealthBarBg.Visible = false
	
	local HealthBarFill = Drawing.new("Line")
	HealthBarFill.Color = ACCENT_MINT
	HealthBarFill.Thickness = 2
	HealthBarFill.Visible = false
	
	local TextTag = Drawing.new("Text")
	TextTag.Color = TEXT_MAIN
	TextTag.Size = 13
	TextTag.Font = 3
	TextTag.Center = true
	TextTag.Outline = true
	TextTag.OutlineColor = BG_DARK
	TextTag.Visible = false
	
	ActiveEspRegistry[player] = {
		Box = Box, 
		Tracer = Tracer,
		Brackets = Brackets,
		HealthBarBg = HealthBarBg,
		HealthBarFill = HealthBarFill,
		TextTag = TextTag
	}
end

local function RemoveEspProfile(player)
	local assets = ActiveEspRegistry[player]
	if assets then
		assets.Box:Destroy()
		assets.Tracer:Destroy()
		assets.HealthBarBg:Destroy()
		assets.HealthBarFill:Destroy()
		assets.TextTag:Destroy()
		for _, line in ipairs(assets.Brackets) do
			line:Destroy()
		end
		ActiveEspRegistry[player] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LocalPlayer then CreateEspProfile(p) end
end
Players.PlayerAdded:Connect(CreateEspProfile)
Players.PlayerRemoving:Connect(RemoveEspProfile)

RunService.RenderStepped:Connect(function()
	for player, assets in pairs(ActiveEspRegistry) do
		local char = player.Character
		local showBox = false
		local showTracer = false
		local showCorners = false
		local showTelemetry = false
		
		if IsTargetValid(char) and not IsTeammate(player) then
			local root = char.HumanoidRootPart
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local pos, onScreen = CurrentCamera:WorldToViewportPoint(root.Position)
			
			if onScreen and humanoid then
				local camDistance = (CurrentCamera.CFrame.Position - root.Position).Magnitude
				local boxHeight = math.clamp((1000 / camDistance) * 3, 10, 200)
				local boxWidth = boxHeight * 0.7
				
				local x, y = pos.X, pos.Y
				local leftX, rightX = x - boxWidth / 2, x + boxWidth / 2
				local topY, bottomY = y - boxHeight / 2, y + boxHeight / 2
				
				if EspBoxesEnabled then
					assets.Box.Size = Vector2.new(boxWidth, boxHeight)
					assets.Box.Position = Vector2.new(leftX, topY)
					showBox = true
				end
				
				if EspTracersEnabled then
					assets.Tracer.From = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y)
					assets.Tracer.To = Vector2.new(x, y)
					showTracer = true
				end
				
				if CornerBoxesEnabled then
					local b = assets.Brackets
					local lLength = boxWidth * 0.25
					
					b[1].From, b[1].To = Vector2.new(leftX, topY), Vector2.new(leftX + lLength, topY)
					b[2].From, b[2].To = Vector2.new(leftX, topY), Vector2.new(leftX, topY + lLength)
					b[3].From, b[3].To = Vector2.new(rightX, topY), Vector2.new(rightX - lLength, topY)
					b[4].From, b[4].To = Vector2.new(rightX, topY), Vector2.new(rightX, topY + lLength)
					b[5].From, b[5].To = Vector2.new(leftX, bottomY), Vector2.new(leftX + lLength, bottomY)
					b[6].From, b[6].To = Vector2.new(leftX, bottomY), Vector2.new(leftX, bottomY - lLength)
					b[7].From, b[7].To = Vector2.new(rightX, bottomY), Vector2.new(rightX - lLength, bottomY)
					b[8].From, b[8].To = Vector2.new(rightX, bottomY), Vector2.new(rightX, bottomY - lLength)
					
					showCorners = true
				end
				
				if TelemetryInfoEnabled then
					local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
					local barX = leftX - 6
					
					assets.HealthBarBg.From = Vector2.new(barX, bottomY)
					assets.HealthBarBg.To = Vector2.new(barX, topY)
					
					assets.HealthBarFill.From = Vector2.new(barX, bottomY)
					assets.HealthBarFill.To = Vector2.new(barX, bottomY - (boxHeight * healthPercent))
					assets.HealthBarFill.Color = healthPercent > 0.5 and ACCENT_MINT or CRITICAL_RED
					
					assets.TextTag.Position = Vector2.new(x, topY - 18)
					assets.TextTag.Text = string.format("%s [%d Studs]", player.Name, math.floor(camDistance))
					
					showTelemetry = true
				end
			end
		end
		
		assets.Box.Visible = showBox
		assets.Tracer.Visible = showTracer
		assets.HealthBarBg.Visible = showTelemetry
		assets.HealthBarFill.Visible = showTelemetry
		assets.TextTag.Visible = showTelemetry
		for i = 1, 8 do assets.Brackets[i].Visible = showCorners end
	end
end)

