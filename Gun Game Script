		TweenService:Create(ScrollFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
	end)

	tabs[tabName] = {Window = ScrollFrame, Button = TabButton, Active = false}
	return ScrollFrame
end

