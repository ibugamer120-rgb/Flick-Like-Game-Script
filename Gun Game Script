	end)
	Frame.MouseLeave:Connect(function()
		TweenService:Create(rowStroke, TweenInfo.new(0.2), {Color = SEPARATOR_LINE}):Play()
	end)

	BindButton.MouseButton1Click:Connect(function()
		createRipple(BindButton, Mouse.X, Mouse.Y)
		if IsBindingKey then return end
		
		IsBindingKey = true
		BindButton.Text = "..."
		BindButton.TextColor3 = TEXT_MUTED
		updateStatus("Awaiting client hardware input action match...", false)
		
		local signalConnection
		signalConnection = UserInputService.InputBegan:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.Keyboard then
				local selectedKey = inputObject.KeyCode
				if selectedKey ~= Enum.KeyCode.Escape then
					BindButton.Text = "[" .. selectedKey.Name .. "]"
					BindButton.TextColor3 = ACCENT_MINT
					callback(selectedKey)
					updateStatus("Assigned assignment successfully.", false)
				else
					BindButton.Text = "[" .. currentKey.Name .. "]"
					BindButton.TextColor3 = ACCENT_MINT
					updateStatus("Keybind configuration cycle aborted.", true)
				end
				IsBindingKey = false
				signalConnection:Disconnect()
			end
		end)
	end)
	
	return BindButton
end

