local ActiveEspRegistry = {}

local function CreateEspProfile(player)
	if ActiveEspRegistry[player] then return end
	
	local Box = Drawing.new("Square")
	Box.Visible = false
	Box.Color = ACCENT_MINT
	Box.Thickness = 1.5
	Box.Filled = false
	Box.Transparency = 0.8
	
	local Tracer = Drawing.new("Line")
	Tracer.Visible = false
	Tracer.Color = TEXT_MAIN
	Tracer.Thickness = 1
	Tracer.Transparency = 0.6
	
	ActiveEspRegistry[player] = {Box = Box, Tracer = Tracer}
end

local function RemoveEspProfile(player)
	if ActiveEspRegistry[player] then
		ActiveEspRegistry[player].Box:Destroy()
		ActiveEspRegistry[player].Tracer:Destroy()
		ActiveEspRegistry[player] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LocalPlayer then CreateEspProfile(p) end
end
Players.PlayerAdded:Connect(CreateEspProfile)
Players.PlayerRemoving:Connect(RemoveEspProfile)

RunService.RenderStepped:Connect(function()
	for player, assets in pairs(ActiveEspRegistry) do
		local char = player.Character
		local showBox = false
		local showTracer = false
		
		if IsTargetValid(char) then
			local root = char.HumanoidRootPart
			local pos, onScreen = CurrentCamera:WorldToViewportPoint(root.Position)
			
			if onScreen then
				local camDistance = (CurrentCamera.CFrame.Position - root.Position).Magnitude
				local boxHeight = math.clamp((1000 / camDistance) * 3, 10, 200)
				local boxWidth = boxHeight * 0.7
				
				if EspBoxesEnabled then
					assets.Box.Size = Vector2.new(boxWidth, boxHeight)
					assets.Box.Position = Vector2.new(pos.X - boxWidth/2, pos.Y - boxHeight/2)
					showBox = true
				end
				
				if EspTracersEnabled then
					assets.Tracer.From = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y)
					assets.Tracer.To = Vector2.new(pos.X, pos.Y)
					showTracer = true
				end
			end
		end
		
		assets.Box.Visible = showBox
		assets.Tracer.Visible = showTracer
	end
end)

