			data.Button.TextColor3 = TEXT_MUTED
		end
		ScrollFrame.Visible = true
		TabButton.BackgroundTransparency = 0
		TabButton.TextColor3 = TEXT_MAIN
	end)

	tabs[tabName] = {Window = ScrollFrame, Button = TabButton}
	return ScrollFrame
