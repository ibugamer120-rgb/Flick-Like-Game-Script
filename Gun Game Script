-- UNIVERSAL TEAM DETECTION MATRIX
----------------------------------------------------------------
local function IsTeammate(player)
	if not TeamCheckEnabled then return false end
	
	if player.Team == LocalPlayer.Team and not player.Neutral then
		return true
	end
	
	local myTeamAttr = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("TeamID") or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Team"))
	local targetTeamAttr = player:GetAttribute("Team") or player:GetAttribute("TeamID") or (player.Character and player.Character:GetAttribute("Team"))
	
	if myTeamAttr and targetTeamAttr and myTeamAttr == targetTeamAttr then
		return true
	end
	
	local teamsFolder = Workspace:FindFirstChild("Teams") or game:GetService("ReplicatedStorage"):FindFirstChild("Teams")
	if teamsFolder then
		for _, teamFolder in ipairs(teamsFolder:GetChildren()) do
			if teamFolder:FindFirstChild(LocalPlayer.Name) and teamFolder:FindFirstChild(player.Name) then
				return true
			end
		end
	end
	
	return false
end

----------------------------------------------------------------
-- ADVANCED RUNTIME TARGETING ENGINE (EXTRAPOLATION & CORE TARGETING)
----------------------------------------------------------------

local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Color = ACCENT_MINT
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Radius = BaseFovRadius
FOVCircle.Filled = false
FOVCircle.Transparency = 0.6

local function IsVisible(targetPart, character)
	local origin = CurrentCamera.CFrame.Position
	local direction = targetPart.Position - origin
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character, CurrentCamera}
	raycastParams.IgnoreWater = true
	
	local raycastResult = Workspace:Raycast(origin, direction, raycastParams)
	return raycastResult == nil
end

local function IsTargetValid(character)
	if not character or not character:IsDescendantOf(Workspace) then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	
	if not humanoid or not head or not hrp then return false end
	if humanoid.Health <= 0.1 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
		return false
	end
	
	return true
end

local function GetDynamicFovRadius()
	local currentFov = CurrentCamera.FieldOfView
	local fovAdjustment = math.tan(math.rad(currentFov / 2)) / math.tan(math.rad(DEFAULT_ROBLOX_FOV / 2))
	return BaseFovRadius * fovAdjustment
end

-- Specialty Structural Target Node Assignment Picker
local function GetTargetPart(character)
	if not IsTargetValid(character) then return nil end
	
	if TargetPartMode == "Head" then
		return character:FindFirstChild("Head")
	elseif TargetPartMode == "Torso" then
		return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	elseif TargetPartMode == "Randomized" then
		local selectionPool = {}
		local head = character:FindFirstChild("Head")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		
		if head then table.insert(selectionPool, head) end
		if hrp then table.insert(selectionPool, hrp) end
		
		return #selectionPool > 0 and selectionPool[math.random(1, #selectionPool)] or nil
	end
	
	return character:FindFirstChild("Head")
end

local function GetClosestTarget()
	local closestTarget = nil
	local maxDistance = GetDynamicFovRadius()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if IsTeammate(player) then continue end
			
			local character = player.Character
			if IsTargetValid(character) then
				local trackingPart = GetTargetPart(character)
				if not trackingPart then continue end
				
				local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(trackingPart.Position)
				
				if onScreen then
					local mousePos = Vector2.new(Mouse.X, Mouse.Y + 36)
					local distanceToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					
					if distanceToMouse < maxDistance then
						if WallCheckEnabled then
							if IsVisible(trackingPart, character) then
								maxDistance = distanceToMouse
								closestTarget = trackingPart
							end
						else
							maxDistance = distanceToMouse
							closestTarget = trackingPart
						end
					end
				end
			end
		end
	end
	return closestTarget
end

-- Delta-Time dependent simulation loop featuring dynamic projectile intercept arrays
RunService.RenderStepped:Connect(function(deltaTime)
	local mousePos = Vector2.new(Mouse.X, Mouse.Y + 36)
	local dynamicRadius = GetDynamicFovRadius()
	
	FOVCircle.Position = mousePos
	FOVCircle.Radius = dynamicRadius
	FOVCircle.Visible = AimbotEnabled and menuVisible

	if AimbotEnabled then
		local targetPart = GetClosestTarget()
		if targetPart and targetPart.Parent and IsTargetValid(targetPart.Parent) then
			local calculatedPosition = targetPart.Position
			
			-- Core Mathematical Extrapolation Engine Block 
			if PredictionSystemEnabled then
				local hrp = targetPart.Parent:FindFirstChild("HumanoidRootPart")
				if hrp then
					local targetVelocity = hrp.AssemblyLinearVelocity
					local lineDistance = (calculatedPosition - CurrentCamera.CFrame.Position).Magnitude
					local estimatedTimeOfFlight = lineDistance / math.max(ProjectileSpeedScalar, 1)
					
					-- Vector extrapolation integration logic
					calculatedPosition = calculatedPosition + (targetVelocity * estimatedTimeOfFlight)
				end
			end
			
			local targetCFrame = CFrame.new(CurrentCamera.CFrame.Position, calculatedPosition)
			if TargetLockEnabled then
				CurrentCamera.CFrame = targetCFrame
			else
				local scopeMultiplier = CurrentCamera.FieldOfView / DEFAULT_ROBLOX_FOV
				local targetTrackingSpeed = SmoothnessDivisor * (1 / math.clamp(scopeMultiplier, 0.1, 1))
				
				local interpolationFactor = 1 - math.exp(-targetTrackingSpeed * deltaTime * 3)
				CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(targetCFrame, math.clamp(interpolationFactor, 0, 1))
			end
		end
	end
end)

