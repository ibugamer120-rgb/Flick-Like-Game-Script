			TweenService:Create(TabButton, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 1, TextColor3 = TEXT_MUTED}):Play()
		end
	end)

	TabButton.MouseButton1Click:Connect(function()
		createRipple(TabButton, Mouse.X, Mouse.Y)
		for tName, data in pairs(tabs) do
			data.Active = false
			data.Button.BackgroundTransparency = 1
			data.Button.TextColor3 = TEXT_MUTED
			if data.Window.Visible then
				-- FIXED: CanvasTransparency removed. Using Position and ScrollBar transparency manipulation instead.
				TweenService:Create(data.Window, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0, -30, 0, 0), ScrollBarImageTransparency = 1}):Play()
