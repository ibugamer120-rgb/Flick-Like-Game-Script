local function addCorner(parent, px)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, px or 6)
	corner.Parent = parent
end

local function addStroke(parent, color, thick)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thick or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

local function createRipple(frame, touchX, touchY)
	local circle = Instance.new("Frame")
	circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	circle.BackgroundTransparency = 0.8
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Size = UDim2.new(0, 0, 0, 0)
	circle.Position = UDim2.new(0, touchX - frame.AbsolutePosition.X, 0, touchY - frame.AbsolutePosition.Y)
	addCorner(circle, 100)
	circle.Parent = frame

	local maxSize = math.max(frame.AbsoluteSize.X, frame.AbsoluteSize.Y) * 1.5
	TweenService:Create(circle, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, maxSize, 0, maxSize),
		BackgroundTransparency = 1
	}):Play()
	task.delay(0.4, function() circle:Destroy() end)
end

